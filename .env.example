# ============================================================
# Đà Nẵng Public Infrastructure System — Environment template
# Copy to .env and adjust values. NEVER commit .env to git.
#
# When using Docker Compose (./scripts/start.ps1), service URLs
# are wired automatically via internal Docker network. The
# values below are used as fallbacks AND for local-native runs.
# ============================================================

# --- Core ---
ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-hex-string-for-jwt-signing
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Database ---
POSTGRES_USER=infra
POSTGRES_PASSWORD=infra_dev_pw
POSTGRES_DB=danang_infra
POSTGRES_PORT=5432
# DATABASE_URL is auto-built inside docker-compose; only used for native runs:
DATABASE_URL=postgresql+asyncpg://infra:infra_dev_pw@localhost:5432/danang_infra
DATABASE_URL_SYNC=postgresql://infra:infra_dev_pw@localhost:5432/danang_infra

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- MinIO / Object storage ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=danang-infra
S3_REGION=ap-southeast-1

# --- Meilisearch ---
MEILI_PORT=7700
MEILI_MASTER_KEY=meili_dev_key

# --- AI Service ---
AI_SERVICE_PORT=8001
AI_USE_REAL_MODEL=false
AI_MODEL_PATH=models/yolov8n.pt
AI_CONFIDENCE_THRESHOLD=0.6

# --- Backend ---
BACKEND_PORT=8000

# --- Frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_MAP_STYLE=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_MAP_CENTER_LAT=16.0544
NEXT_PUBLIC_MAP_CENTER_LNG=108.2022
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=12

# --- JWT ---
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Rate limiting ---
RATE_LIMIT_LOGIN_PER_15M=5
RATE_LIMIT_REPORT_PER_HOUR=5

# --- Mail (MailHog dev catcher) ---
MAILHOG_SMTP_PORT=1025
MAILHOG_HTTP_PORT=8025
EMAIL_FROM=noreply@danang.gov.vn

# --- External integrations (optional) ---
SENDGRID_API_KEY=
MAILGUN_API_KEY=
OPENAQ_API_BASE=https://api.openaq.org/v2
SENTRY_DSN=
SENTRY_DSN_FRONTEND=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
